# infra/.env trên máy chủ production. chmod 600. KHÔNG commit.
# Sinh mật khẩu bằng `openssl rand -hex 32`. KHÔNG dùng -base64: ký tự "/" "+" làm hỏng DATABASE_URL và REDIS_URL.
DOMAIN=app.tencongty.vn
ACME_EMAIL=it@tencongty.vn
IMAGE_PREFIX=ghcr.io/ten-to-chuc/ten-repo

APP_ORIGIN=https://app.tencongty.vn
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
SESSION_TTL_HOURS=12
SESSION_MAX_DAYS=7
DB_POOL_MAX=10
WORKER_CONCURRENCY=5

# Tệp đính kèm và xuất file (ADR-0005). FILES_DIR là thư mục trên host, mount vào api/worker tại /data/files.
FILES_DIR=/opt/app-data/files
FILE_MAX_MB=10
EXPORT_CONCURRENCY=2
EXPORT_TTL_HOURS=24
EXPORT_MAX_ROWS=100000
FILES_BACKUP_KEEP_DAYS=30

POSTGRES_USER=app
POSTGRES_PASSWORD=thay-bang-chuoi-ngau-nhien-32-ky-tu
POSTGRES_DB=app
DATABASE_URL=postgresql://app:thay-bang-chuoi-ngau-nhien-32-ky-tu@postgres:5432/app

REDIS_PASSWORD=thay-bang-chuoi-ngau-nhien-32-ky-tu
REDIS_URL=redis://:thay-bang-chuoi-ngau-nhien-32-ky-tu@redis:6379/0

# Chỉ dùng khi seed lần đầu, xóa khỏi file sau khi đã đổi mật khẩu admin.
SEED_ADMIN_EMAIL=admin@tencongty.vn
SEED_ADMIN_PASSWORD=

# Sao lưu ra ngoài máy chủ: tên remote rclone + đường dẫn. Để trống = chỉ lưu cục bộ (KHÔNG đạt chuẩn 3-2-1).
BACKUP_REMOTE=offsite:ten-bucket/app-backups
BACKUP_KEEP_DAYS=14

# Webhook nhận cảnh báo (Telegram bot, Slack, Google Chat, Zalo OA qua middleware...). Nhận JSON {"text": "..."}.
ALERT_WEBHOOK_URL=
