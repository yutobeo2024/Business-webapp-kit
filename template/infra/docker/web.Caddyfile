# Caddy bên trong container web: chỉ phục vụ file tĩnh của SPA. TLS do Caddy ngoài (infra/Caddyfile) xử lý.
:80 {
	root * /srv
	encode zstd gzip

	# Không phục vụ source map ra ngoài (lộ mã nguồn). Source map chỉ dùng để upload lên công cụ theo dõi lỗi.
	@sourcemaps path *.map
	respond @sourcemaps 404

	# File trong /assets có hash trong tên: cache vĩnh viễn. Mọi thứ khác (index.html qua mọi đường dẫn SPA) phải
	# kiểm lại mỗi lần, nếu không người dùng giữ index.html cũ trỏ tới JS đã bị xóa sau deploy và thấy trang trắng.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@notAssets not path /assets/*
	header @notAssets Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
